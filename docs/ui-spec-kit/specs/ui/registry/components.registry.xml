  <!--
    Реестр helper-функций, используемых в bind-выражениях `{fn(...)}` спеков (AUDIT.md C11).
    Каждый вызов в спеках обязан иметь запись здесь: имя, сигнатура, семантика, модуль-владелец.
    Функции языка validation-выражений (trim, matches, isEmail) — builtins, не helpers.
  -->
  <Helpers>
    <Helper name="formatTime" signature="(atUtc: utcDateTime, timeZone: IanaTimeZone) =&gt; string" module="@/shared/datetime">Время «HH:mm» момента atUtc в указанной timezone (owner-флоу — timezone владельца).</Helper>
    <Helper name="formatUtcOffset" signature="(timeZone: IanaTimeZone) =&gt; string" module="@/shared/datetime">Подпись смещения timezone вида «UTC+02:00» на текущую дату.</Helper>
    <Helper name="formattedSlot" signature="(startAtUtc: utcDateTime, endAtUtc: utcDateTime) =&gt; string" module="@/shared/datetime">Читаемая подпись выбранного слота — дата и интервал времени в локальной timezone гостя («31 июля · 10:00–10:30»).</Helper>
    <Helper name="dateLabel" signature="(atUtc: utcDateTime) =&gt; string" module="@/shared/datetime">Дата момента atUtc в локальной timezone гостя.</Helper>
    <Helper name="timeLabel" signature="(atUtc: utcDateTime) =&gt; string" module="@/shared/datetime">Время «HH:mm» момента atUtc в локальной timezone гостя.</Helper>
    <Helper name="groupBookingsByOwnerDate" signature="(bookings: BookingView[], timeZone: IanaTimeZone) =&gt; { id: string; title: string; bookings: BookingView[] }[]" module="@/shared/datetime">Группировка встреч по календарной дате в timezone владельца; группы и встречи внутри отсортированы по startAt по возрастанию.</Helper>
    <Helper name="formatWeekdays" signature="(daysOfWeek: Weekday[]) =&gt; string" module="@/features/availability/lib">Компактная подпись дней недели («Пн–Пт», «Пн, Ср, Пт»); смежные дни сворачиваются в диапазон.</Helper>
    <Helper name="formatDaysOff" signature="(intervals: WorkingInterval[]) =&gt; string" module="@/features/availability/lib">Перечисление дней недели, не покрытых ни одним интервалом («Выходные: Сб, Вс»).</Helper>
    <Helper name="formatAvailabilitySummary" signature="(rules: AvailabilityRule[]) =&gt; string" module="@/features/availability/lib">Краткая сводка графика для settings row («Пн–Пт · 09:00–18:00»).</Helper>
    <Helper name="toAvailabilityRules" signature="(intervals: WorkingInterval[]) =&gt; AvailabilityRule[]" module="@/features/availability/lib">Маппинг view-интервалов в контрактные правила: отбрасывает client-only id, приводит Weekday (нижний регистр) к контрактному DayOfWeek.</Helper>
    <Helper name="overwriteMessage" signature="(intervals: WorkingInterval[], startLocal: localTime, endLocal: localTime) =&gt; string" module="@/features/availability/lib">Текст подтверждения перезаписи индивидуальных интервалов новым временем.</Helper>
    <Helper name="applyDaysLabel" signature="(count: int32) =&gt; string" module="@/features/availability/lib">Подпись CTA bottom sheet по числу выбранных дней («Применить к 5 дням»).</Helper>
    <Helper name="durationLabel" signature="(durationMinutes: int32) =&gt; string" module="@/features/event-types/lib">Читаемая длительность встречи («30 минут», «1 час»).</Helper>
    <Helper name="fieldError" signature="(field: string) =&gt; string | null" module="@/shared/forms">Сообщение из $state.fieldErrors для поля field; null, если ошибки нет.</Helper>
    <Helper name="fullDateLabel" signature="(date: string) =&gt; string" module="@/shared/datetime">Полная подпись календарной даты формата YYYY-MM-DD («Пятница, 31 июля»); служит и accessibilityLabel чипа даты.</Helper>
    <Helper name="availableDates" signature="(slots: Slot[], timeZone: IanaTimeZone) =&gt; AvailableDate[]" module="@/features/slots/lib">Календарные даты (YYYY-MM-DD в timeZone гостя), у которых есть хотя бы один слот, по возрастанию; каждая с подписями дня недели и числа. Даты без слотов в результат не попадают.</Helper>
    <Helper name="slotsOnDate" signature="(slots: Slot[], date: string, timeZone: IanaTimeZone) =&gt; Slot[]" module="@/features/slots/lib">Слоты, попадающие на календарную дату date в timeZone гостя, хронологически по startAtUtc.</Helper>
    <Helper name="selectedSlotMissing" signature="(slots: Slot[], selected: Slot | null) =&gt; boolean" module="@/features/slots/lib">true, если ранее выбранного слота больше нет в перезагруженном наборе (слот заняли). При selected == null возвращает false.</Helper>
    <Helper name="eventTypeAccentIndex" signature="(id: string) =&gt; int32" module="@/features/event-types/lib">Индекс акцентного цвета плитки типа встречи: 32-битный FNV-1a от EventType.id по модулю 6. Один id всегда даёт один индекс; результат не зависит ни от порядка элементов, ни от появления новых типов.</Helper>
    <Helper name="newBookingKey" signature="() =&gt; string" module="@/features/guest/lib">Новый UUID v4 — ключ идемпотентности CreateBookingRequest.id. Генерируется до первой попытки создания брони, чтобы повтор был распознаваем сервером.</Helper>
  </Helpers>
</ComponentRegistry>