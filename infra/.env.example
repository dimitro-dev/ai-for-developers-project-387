# Переменные локального контура PostgreSQL (infra/compose.yml).
# Значения совпадают с дефолтами compose.yml: контур поднимается и без .env.
# Файл нужен, только чтобы что-то переопределить — скопируй его в infra/.env.
#
# Контур предназначен исключительно для локальной учебной среды.
# Реальные секреты сюда не попадают: infra/.env в .gitignore, .env.example — нет.

POSTGRES_USER=minical
POSTGRES_PASSWORD=minical

# База разработки.
POSTGRES_DB=minical

# База для проверок back/002; создаётся init-скриптом на пустом volume.
POSTGRES_TEST_DB=minical_test

# Порт на хосте; в контейнере всегда 5432.
POSTGRES_PORT=5432

# Наполнять ли пустое хранилище демо-календарём: передаётся сервису api контура.
# Пустое значение и отсутствие переменной — выключено; включают "1" или "true".
SEED_DEMO=
